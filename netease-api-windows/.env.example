# 复制本文件为 .env 后按需修改： copy .env.example .env

# ---- 服务配置 ----
# 对外端口（宿主机映射端口由 docker-compose.yml 读取）
PORT=3000
# 监听地址，容器内必须是 0.0.0.0，否则宿主机访问不到
HOST=0.0.0.0

# ---- 网易云登录态 ----
# 通过 `npm run qrlogin` 扫码后填入，留空则为未登录状态（仅能调用公开接口）
# 更新本值后执行 `docker compose restart netease-api` 即可生效，无需重新构建镜像
NCM_COOKIE=

# ---- 可选 ----
# 日志级别：error | warn | info | debug
LOG_LEVEL=info
